{
  "name": "koishi-plugin-chatluna-spark",
  "description": "为 ChatLuna 添加提醒、跟进、定时任务、节日问候和主动聊天，并为 Character 补充节日问候",
  "version": "1.5.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "vioaki",
  "keywords": [
    "koishi",
    "koishi-plugin",
    "chatluna",
    "ai",
    "chatbot",
    "reminder",
    "proactive",
    "scheduled"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vioaki/koishi-plugin-chatluna-spark.git"
  },
  "homepage": "https://github.com/vioaki/koishi-plugin-chatluna-spark#readme",
  "bugs": {
    "url": "https://github.com/vioaki/koishi-plugin-chatluna-spark/issues"
  },
  "koishi": {
    "description": {
      "zh": "为 ChatLuna 添加提醒、跟进、定时任务、节日问候和主动聊天，并为 Character 补充节日问候"
    },
    "service": {
      "required": [
        "database",
        "chatluna",
        "chatluna_agent"
      ],
      "optional": [
        "chatluna_character_trigger"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf lib",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && npm run format:check",
    "format": "prettier --write \"{src,tests}/**/*.{ts,js}\" \"*.json\" README.md",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,js}\" \"*.json\" README.md",
    "audit:prod": "npm audit --omit=dev",
    "test:unit": "npm run build && node --test tests/*.test.js",
    "test:package": "npm pack --dry-run --json",
    "test": "npm run typecheck && npm run test:unit && npm run test:package",
    "prepack": "npm run clean && npm run build",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@langchain/core": "^0.3.80",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "koishi": "^4.18.9",
    "koishi-plugin-chatluna": ">=1.4.0-alpha.40 <2.0.0",
    "koishi-plugin-chatluna-agent": ">=1.0.41 <2.0.0",
    "koishi-plugin-chatluna-character": ">=0.0.230 <0.1.0"
  },
  "peerDependenciesMeta": {
    "koishi-plugin-chatluna-character": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "koishi": "^4.18.9",
    "koishi-plugin-chatluna": "1.4.0-alpha.41",
    "koishi-plugin-chatluna-agent": "1.0.41",
    "koishi-plugin-chatluna-character": "0.0.230",
    "prettier": "^3.6.2",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "langsmith": "0.6.0",
    "uuid": "^11.1.1"
  }
}
